# Bu dosyayi .env.local olarak kopyalayin ve degerleri doldurun.
# Degerleri uretmek icin:  npm run parola -- "secilen-parolaniz"

ADMIN_PAROLA_HASH=
OTURUM_ANAHTARI=

# Sitenin yayindaki adresi. Sitemap, robots.txt ve paylasim onizlemeleri
# bu adresi kullanir.
SITE_URL=https://basariyapi.com

# Supabase projesi (Ayarlar > API sayfasindan alinir).
SUPABASE_URL=

# service_role anahtari RLS'i BYPASS eder — tam yetkilidir.
# ASLA NEXT_PUBLIC_ onekiyle tanimlamayin: NEXT_PUBLIC_ degiskenler
# tarayiciya gomulur ve anahtar herkese acik hale gelir. Bu anahtar
# yalnizca sunucuda (lib/db.ts) kullanilir.
SUPABASE_SERVICE_ROLE_KEY=
