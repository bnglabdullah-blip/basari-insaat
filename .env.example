# Bu dosyayi .env.local olarak kopyalayin ve degerleri doldurun.
# Degerleri uretmek icin:  npm run parola -- "secilen-parolaniz"

ADMIN_PAROLA_HASH=
OTURUM_ANAHTARI=

# Sitenin yayindaki adresi. Sitemap, robots.txt ve paylasim onizlemeleri
# bu adresi kullanir.
SITE_URL=https://basariinsaat.com

